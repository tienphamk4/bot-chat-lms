# EDU-DOCBOT — mẫu cấu hình. Chép thành .env rồi điền.
#   cp .env.example .env && chmod 600 .env
# KHÔNG commit .env. Trên máy chủ nạp qua EnvironmentFile của systemd.

# --- CSDL -------------------------------------------------------------------
# Driver mặc định PyMySQL. Đổi sang driver chính thức:
#   mysql+mariadbconnector://docbot:MAT_KHAU@127.0.0.1:3306/edu_docbot
DB_DSN=mysql+pymysql://docbot:MAT_KHAU@127.0.0.1:3306/edu_docbot?charset=utf8mb4

# --- Tệp --------------------------------------------------------------------
# Thư mục gốc chứa tài liệu. documents.file_path là đường dẫn TƯƠNG ĐỐI trong đây.
FILES_ROOT=/srv/edu-docbot/files
# Tiền tố internal location của nginx dùng cho X-Accel-Redirect.
XACCEL_PREFIX=/protected-files

# --- Gemini / Vertex AI -----------------------------------------------------
# Tắt (0) thì chỉ chạy router rule-based — demo không tốn một token nào.
# Bật (1) thì điền MỘT trong hai cách xác thực:
#   Cách 1: GEMINI_API_KEY (lấy ở https://aistudio.google.com/apikey) — ưu tiên.
#   Cách 2: GOOGLE_CLOUD_PROJECT + ADC/service account (Vertex AI, production).
USE_LLM_ROUTER=1
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
# LLM_LOCATION (không dùng tên GOOGLE_CLOUD_LOCATION — dễ bị biến OS của gcloud đè).
# gemini-3.5-flash-lite cần 'global'; các model 2.5 chạy được us-central1.
LLM_LOCATION=global
# Đường dẫn file service account JSON. Bỏ trống nếu máy chủ đã có ADC sẵn.
GOOGLE_APPLICATION_CREDENTIALS=
ROUTER_MODEL=gemini-2.5-flash-lite

# --- Chi phí & quota (KT-10) ------------------------------------------------
QUOTA_DAILY_TOKENS=20000
DAILY_BUDGET_USD=1.0
# USD / 1 triệu token, model router. Kiểm tra lại tại bảng giá Vertex AI.
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.40

# --- Giai đoạn 2: RAG (mặc định trong code, ghi đè khi cần) ------------------
# EMBED_DIM=768
# GEN_MODEL=gemini-2.5-flash-lite
# GEN_MAX_OUTPUT_TOKENS=400
# GEN_TEMPERATURE=0.2
# RAG_TOPK_PER_CHANNEL=20
# RERANK_ENABLED=0                   # bật cần: pip install -r requirements-rerank.txt
# EMBED_MODEL=gemini-embedding-2     # đổi = phải chạy `ingest.cli reembed-all`
# EMBED_LOCATION=global             # 'global' 6000 req/phút; us-central1 chỉ 5
# CHUNK_CONTEXT_LLM=1                # gắn bối cảnh cho chunk khi nạp (~0,02 USD/tài liệu 83 trang)
# PRICE_EMBED_PER_MTOK=0.15

# --- Cache ------------------------------------------------------------------
CACHE_TTL_SECONDS=86400

# --- Khác -------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=
# Đặt chuỗi bí mật bất kỳ → mọi endpoint /admin đòi thêm header X-Admin-Token
# khớp (trang quản trị sẽ tự hỏi mã một lần). Trống = chế độ demo.
ADMIN_TOKEN=

# --- Đường liên hệ chèn vào câu "không tìm thấy" -----------------------------
# Để trống thì bot không nhắc gì tới liên hệ. Chỉ điền số/địa chỉ THẬT.
CONTACT_HOTLINE=
CONTACT_WEBSITE=
