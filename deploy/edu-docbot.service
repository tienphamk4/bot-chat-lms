# /etc/systemd/system/edu-docbot.service
# systemctl daemon-reload && systemctl enable --now edu-docbot

[Unit]
Description=EDU-DOCBOT API (FastAPI/uvicorn)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=exec
User=docbot
Group=docbot
WorkingDirectory=/srv/edu-docbot/app
EnvironmentFile=/srv/edu-docbot/.env
ExecStart=/srv/edu-docbot/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 2
Restart=on-failure
RestartSec=3

# Hardening theo thiết kế mục 8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/edu-docbot/files /srv/edu-docbot/logs

[Install]
WantedBy=multi-user.target
