# /etc/systemd/system/edu-docbot.service
# systemctl daemon-reload && systemctl enable --now edu-docbot

[Unit]
# CSDL là Cloud SQL, nối qua Auth Proxy chạy ở 127.0.0.1:3306 — không có
# mariadb.service trên máy này.
Description=EDU-DOCBOT API (FastAPI/uvicorn)
After=network.target cloud-sql-proxy.service
Wants=cloud-sql-proxy.service

[Service]
Type=exec
User=docbot
Group=docbot
# Gốc dự án, KHÔNG phải .../app: `app.main:app` là đường dẫn gói tính từ đây.
# Đặt vào /srv/edu-docbot/app thì uvicorn không import nổi và service chết ngay.
WorkingDirectory=/srv/edu-docbot
EnvironmentFile=/srv/edu-docbot/.env
ExecStart=/srv/edu-docbot/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 2
Restart=on-failure
RestartSec=3

# Hardening theo thiết kế mục 8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/edu-docbot/files /srv/edu-docbot/logs

[Install]
WantedBy=multi-user.target
