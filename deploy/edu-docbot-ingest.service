# /etc/systemd/system/edu-docbot-ingest.service
# Oneshot — chạy bởi edu-docbot-ingest.timer, hoặc tay: systemctl start edu-docbot-ingest

[Unit]
Description=EDU-DOCBOT nạp tài liệu theo lô
After=cloud-sql-proxy.service
Wants=cloud-sql-proxy.service

[Service]
Type=oneshot
User=docbot
Group=docbot
# Gốc dự án — `python -m ingest.cli` cần thấy gói ingest/ và app/ từ cwd.
WorkingDirectory=/srv/edu-docbot
EnvironmentFile=/srv/edu-docbot/.env
ExecStart=/srv/edu-docbot/venv/bin/python -m ingest.cli scan

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/edu-docbot/files /srv/edu-docbot/logs
