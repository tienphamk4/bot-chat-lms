# Dự án viết trên Windows nhưng chạy trên Linux. Script shell phải là LF:
# một ký tự CR lọt vào dòng `#!/usr/bin/env bash` là VM báo
# "bad interpreter: /usr/bin/env bash^M" và deploy đỏ không rõ lý do.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
